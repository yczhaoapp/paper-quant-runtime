{
  "$defs": {
    "Conversion": {
      "additionalProperties": false,
      "properties": {
        "affected_symbols": {
          "items": {
            "type": "string"
          },
          "title": "Affected Symbols",
          "type": "array"
        },
        "can_disable": {
          "const": true,
          "default": true,
          "title": "Can Disable",
          "type": "boolean"
        },
        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "lossy": {
          "title": "Lossy",
          "type": "boolean"
        },
        "output_event_count": {
          "minimum": 1,
          "title": "Output Event Count",
          "type": "integer"
        },
        "output_sha256": {
          "title": "Output Sha256",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "object"
        },
        "policy_switch": {
          "enum": [
            "symbol_map",
            "allow_day_aggregation"
          ],
          "title": "Policy Switch",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_event_count": {
          "minimum": 1,
          "title": "Source Event Count",
          "type": "integer"
        },
        "transformation": {
          "enum": [
            "symbol_map",
            "minute_to_day"
          ],
          "title": "Transformation",
          "type": "string"
        }
      },
      "required": [
        "transformation",
        "reason",
        "policy_switch",
        "source_event_count",
        "output_event_count",
        "affected_symbols",
        "input_sha256",
        "output_sha256",
        "parameters",
        "lossy"
      ],
      "title": "Conversion",
      "type": "object"
    },
    "EngineCapability": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array",
          "uniqueItems": true
        },
        "data_fields": {
          "items": {
            "type": "string"
          },
          "title": "Data Fields",
          "type": "array",
          "uniqueItems": true
        },
        "engine_id": {
          "title": "Engine Id",
          "type": "string"
        },
        "execution_fields": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "propertyNames": {
            "$ref": "#/$defs/Granularity"
          },
          "title": "Execution Fields",
          "type": "object"
        },
        "financing_modes": {
          "default": [
            "cash_only",
            "unbounded_margin"
          ],
          "items": {
            "enum": [
              "cash_only",
              "unbounded_margin"
            ],
            "type": "string"
          },
          "title": "Financing Modes",
          "type": "array",
          "uniqueItems": true
        },
        "granularities": {
          "items": {
            "$ref": "#/$defs/Granularity"
          },
          "title": "Granularities",
          "type": "array",
          "uniqueItems": true
        },
        "max_symbols": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Symbols"
        }
      },
      "required": [
        "engine_id",
        "granularities",
        "data_fields",
        "actions"
      ],
      "title": "EngineCapability",
      "type": "object"
    },
    "EngineProfile": {
      "additionalProperties": false,
      "properties": {
        "engine_id": {
          "title": "Engine Id",
          "type": "string"
        },
        "settings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Settings",
          "type": "object"
        }
      },
      "required": [
        "engine_id",
        "settings"
      ],
      "title": "EngineProfile",
      "type": "object"
    },
    "Granularity": {
      "enum": [
        "tick",
        "minute",
        "day"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "RunPolicy": {
      "additionalProperties": false,
      "properties": {
        "aggregation_session_close": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Session Close"
        },
        "aggregation_session_open": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Session Open"
        },
        "allow_day_aggregation": {
          "default": false,
          "title": "Allow Day Aggregation",
          "type": "boolean"
        },
        "financing_mode": {
          "default": "cash_only",
          "enum": [
            "cash_only",
            "unbounded_margin"
          ],
          "title": "Financing Mode",
          "type": "string"
        },
        "sandbox": {
          "default": "development",
          "enum": [
            "development",
            "strict"
          ],
          "title": "Sandbox",
          "type": "string"
        },
        "symbol_map": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Symbol Map",
          "type": "object"
        }
      },
      "title": "RunPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_actions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Actions",
      "type": "array",
      "uniqueItems": true
    },
    "conversions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Conversion"
      },
      "title": "Conversions",
      "type": "array"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_sha256": {
      "title": "Dataset Sha256",
      "type": "string"
    },
    "declaration_sha256": {
      "title": "Declaration Sha256",
      "type": "string"
    },
    "effective_events_sha256": {
      "title": "Effective Events Sha256",
      "type": "string"
    },
    "engine_capability": {
      "$ref": "#/$defs/EngineCapability"
    },
    "engine_id": {
      "title": "Engine Id",
      "type": "string"
    },
    "engine_profile": {
      "$ref": "#/$defs/EngineProfile"
    },
    "engine_profile_sha256": {
      "title": "Engine Profile Sha256",
      "type": "string"
    },
    "engine_sha256": {
      "title": "Engine Sha256",
      "type": "string"
    },
    "financing_mode": {
      "enum": [
        "cash_only",
        "unbounded_margin"
      ],
      "title": "Financing Mode",
      "type": "string"
    },
    "granularity": {
      "$ref": "#/$defs/Granularity"
    },
    "max_abs_position": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Abs Position"
    },
    "max_order_quantity": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Max Order Quantity"
    },
    "package_class_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Class Name"
    },
    "package_source_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Source Sha256"
    },
    "policy": {
      "$ref": "#/$defs/RunPolicy"
    },
    "policy_sha256": {
      "title": "Policy Sha256",
      "type": "string"
    },
    "required_fields": {
      "items": {
        "type": "string"
      },
      "title": "Required Fields",
      "type": "array",
      "uniqueItems": true
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "sandbox": {
      "enum": [
        "development",
        "strict"
      ],
      "title": "Sandbox",
      "type": "string"
    },
    "strategy_id": {
      "title": "Strategy Id",
      "type": "string"
    },
    "symbols": {
      "items": {
        "type": "string"
      },
      "title": "Symbols",
      "type": "array",
      "uniqueItems": true
    },
    "training_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Training Sha256"
    }
  },
  "required": [
    "run_id",
    "strategy_id",
    "dataset_id",
    "engine_id",
    "sandbox",
    "financing_mode",
    "granularity",
    "symbols",
    "required_fields",
    "allowed_actions",
    "max_abs_position",
    "max_order_quantity",
    "declaration_sha256",
    "dataset_sha256",
    "effective_events_sha256",
    "training_sha256",
    "engine_capability",
    "engine_sha256",
    "engine_profile",
    "engine_profile_sha256",
    "policy",
    "policy_sha256"
  ],
  "title": "ExecutionPlan",
  "type": "object"
}
