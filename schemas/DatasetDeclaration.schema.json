{
  "$defs": {
    "Granularity": {
      "enum": [
        "tick",
        "minute",
        "day"
      ],
      "title": "Granularity",
      "type": "string"
    },
    "MarketKind": {
      "enum": [
        "bar",
        "trade",
        "quote_l1",
        "book_l2"
      ],
      "title": "MarketKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bar_seconds": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bar Seconds"
    },
    "book_depth": {
      "anyOf": [
        {
          "minimum": 2,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Book Depth"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "contract_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Contract Version",
      "type": "string"
    },
    "dataset_id": {
      "title": "Dataset Id",
      "type": "string"
    },
    "event_count": {
      "minimum": 1,
      "title": "Event Count",
      "type": "integer"
    },
    "fields": {
      "items": {
        "type": "string"
      },
      "title": "Fields",
      "type": "array",
      "uniqueItems": true
    },
    "granularity": {
      "$ref": "#/$defs/Granularity"
    },
    "market_kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/MarketKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "session_close": {
      "anyOf": [
        {
          "format": "time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Close"
    },
    "session_open": {
      "anyOf": [
        {
          "format": "time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Open"
    },
    "session_timezone": {
      "default": "UTC",
      "title": "Session Timezone",
      "type": "string"
    },
    "symbols": {
      "items": {
        "type": "string"
      },
      "title": "Symbols",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "dataset_id",
    "granularity",
    "fields",
    "symbols",
    "event_count",
    "content_sha256"
  ],
  "title": "DatasetDeclaration",
  "type": "object"
}
