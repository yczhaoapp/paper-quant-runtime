{
  "additionalProperties": false,
  "properties": {
    "fee": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "pattern": "^(?:\\+?(?:(?:0|[1-9]\\d*)(?:\\.\\d*)?|\\.\\d+)|-0+(?:\\.0*)?)(?:[eE][+-]?\\d+)?$",
          "type": "string"
        }
      ],
      "title": "Fee"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "pattern": "^\\+?(?:0*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:[eE][+-]?\\d+)?$",
          "type": "string"
        }
      ],
      "title": "Price"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "pattern": "^\\+?(?:0*[1-9]\\d*(?:\\.\\d*)?|0*\\.\\d*[1-9]\\d*)(?:[eE][+-]?\\d+)?$",
          "type": "string"
        }
      ],
      "title": "Quantity"
    },
    "side": {
      "enum": [
        "buy",
        "sell"
      ],
      "title": "Side",
      "type": "string"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "order_id",
    "symbol",
    "side",
    "quantity",
    "price",
    "fee",
    "timestamp"
  ],
  "title": "Fill",
  "type": "object"
}
