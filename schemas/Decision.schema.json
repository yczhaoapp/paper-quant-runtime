{
  "$defs": {
    "NoOp": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "none",
          "default": "none",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "NoOp",
      "type": "object"
    },
    "Prediction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "prediction",
          "default": "prediction",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "symbol",
        "value",
        "reason"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "SubmitOrder": {
      "additionalProperties": false,
      "properties": {
        "client_order_id": {
          "title": "Client Order Id",
          "type": "string"
        },
        "kind": {
          "const": "submit_order",
          "default": "submit_order",
          "title": "Kind",
          "type": "string"
        },
        "limit_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit Price"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "side": {
          "enum": [
            "buy",
            "sell"
          ],
          "title": "Side",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "client_order_id",
        "symbol",
        "side",
        "quantity",
        "reason"
      ],
      "title": "SubmitOrder",
      "type": "object"
    },
    "TargetPosition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "target_position",
          "default": "target_position",
          "title": "Kind",
          "type": "string"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Quantity"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "quantity",
        "reason"
      ],
      "title": "TargetPosition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "none": "#/$defs/NoOp",
            "prediction": "#/$defs/Prediction",
            "submit_order": "#/$defs/SubmitOrder",
            "target_position": "#/$defs/TargetPosition"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NoOp"
          },
          {
            "$ref": "#/$defs/Prediction"
          },
          {
            "$ref": "#/$defs/TargetPosition"
          },
          {
            "$ref": "#/$defs/SubmitOrder"
          }
        ]
      },
      "title": "Actions",
      "type": "array"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "event_time": {
      "format": "date-time",
      "title": "Event Time",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "event_time",
    "actions"
  ],
  "title": "Decision",
  "type": "object"
}
