          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "strategy_id": {
          "title": "Strategy Id",
          "type": "string"
        },
        "training_sha256": {
          "title": "Training Sha256",
          "type": "string"
        }
      },
      "required": [
        "strategy_id",
        "training_sha256",
        "content_sha256",
        "format",
        "relative_path"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Conversion": {
      "additionalProperties": false,
