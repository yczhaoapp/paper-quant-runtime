        "input_sha256": {
          "title": "Input Sha256",
          "type": "string"
        },
        "lossy": {
          "title": "Lossy",
          "type": "boolean"
        },
        "output_event_count": {
          "minimum": 1,
          "title": "Output Event Count",
          "type": "integer"
        },
        "output_sha256": {
          "title": "Output Sha256",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Parameters",
          "type": "object"
        },
        "policy_switch": {
          "enum": [
            "symbol_map",
            "allow_day_aggregation"
          ],
