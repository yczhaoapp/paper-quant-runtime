          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "source_event_count": {
          "minimum": 1,
          "title": "Source Event Count",
          "type": "integer"
        },
        "transformation": {
          "enum": [
            "symbol_map",
            "minute_to_day"
          ],
          "title": "Transformation",
          "type": "string"
        }
