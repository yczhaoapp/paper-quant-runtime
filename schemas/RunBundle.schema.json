      "required": [
        "transformation",
        "reason",
        "policy_switch",
        "source_event_count",
        "output_event_count",
        "affected_symbols",
        "input_sha256",
        "output_sha256",
        "parameters",
        "lossy"
      ],
      "title": "Conversion",
      "type": "object"
    },
    "DataNeed": {
      "additionalProperties": false,
      "properties": {
        "bar_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bar Seconds"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array",
          "uniqueItems": true
        },
        "granularity": {
          "$ref": "#/$defs/Granularity"
        },
        "market_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_staleness_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Staleness Seconds"
        },
        "minimum_book_depth": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Book Depth"
        },
        "minimum_events_per_symbol": {
          "default": 1,
          "minimum": 1,
          "title": "Minimum Events Per Symbol",
          "type": "integer"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "granularity",
        "fields",
        "symbols"
      ],
      "title": "DataNeed",
      "type": "object"
    },
    "DatasetDeclaration": {
      "additionalProperties": false,
      "properties": {
        "bar_seconds": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bar Seconds"
        },
        "book_depth": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Book Depth"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Contract Version",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "event_count": {
          "minimum": 1,
          "title": "Event Count",
          "type": "integer"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array",
          "uniqueItems": true
        },
        "granularity": {
          "$ref": "#/$defs/Granularity"
        },
        "market_kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "session_close": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Close"
        },
        "session_open": {
          "anyOf": [
            {
              "format": "time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Open"
        },
        "session_timezone": {
          "default": "UTC",
          "title": "Session Timezone",
          "type": "string"
        },
        "symbols": {
          "items": {
            "type": "string"
          },
          "title": "Symbols",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "dataset_id",
        "granularity",
        "fields",
        "symbols",
        "event_count",
        "content_sha256"
      ],
      "title": "DatasetDeclaration",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "discriminator": {
              "mapping": {
                "none": "#/$defs/NoOp",
                "prediction": "#/$defs/Prediction",
                "submit_order": "#/$defs/SubmitOrder",
                "target_position": "#/$defs/TargetPosition"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/NoOp"
              },
              {
                "$ref": "#/$defs/Prediction"
              },
              {
                "$ref": "#/$defs/TargetPosition"
              },
              {
                "$ref": "#/$defs/SubmitOrder"
              }
            ]
          },
          "title": "Actions",
          "type": "array"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "event_time",
        "actions"
      ],
      "title": "Decision",
      "type": "object"
    },
